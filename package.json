{
	"name": "dibakar.me",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"predev": "bun scripts/generate-image-manifest.mjs",
		"dev": "next dev --turbopack",
		"prebuild": "bun scripts/generate-image-manifest.mjs",
		"build": "next build",
		"start": "next start",
		"images": "bun scripts/generate-image-manifest.mjs",
		"logos": "bun scripts/generate-logo-derivatives.mjs",
		"images:art": "bun scripts/generate-blog-art.mjs",
		"dino": "bun scripts/generate-dino-hero.mjs",
		"format": "prettier --write .",
		"deploy": "bun run build && bunx wrangler deploy",
		"db:migrate:local": "bunx wrangler d1 migrations apply dibakar-me-comments --local",
		"db:migrate:remote": "bunx wrangler d1 migrations apply dibakar-me-comments --remote"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"gray-matter": "^4.0.3",
		"mermaid": "^12.2.0",
		"next": "^15.5.4",
		"prettier": "^3.9.9",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"rehype-raw": "^7.0.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"sharp": "^0.34.4",
		"tailwind-merge": "^3.5.0",
		"unified": "^11.0.5"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20251004.0",
		"@tailwindcss/postcss": "^4.1.13",
		"@types/node": "^24.5.2",
		"@types/react": "^19.1.13",
		"@types/react-dom": "^19.1.9",
		"gifenc": "^1.0.3",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.1.13",
		"typescript": "^5.9.2",
		"wrangler": "^4.40.0"
	}
}
