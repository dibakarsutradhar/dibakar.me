// Cloudflare Worker config: hosts the comments API on api.dibakar.me.
// The site itself stays on the dibakar-me Pages project; the Worker accepts
// only browser origins dibakar.me / www.dibakar.me (plus same-origin calls).
//
// The Turnstile secret is not stored here — set it once with
// `wrangler secret put TURNSTILE_SECRET_KEY`.
{
	"name": "dibakar-me",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./out",
		"not_found_handling": "404-page",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dibakar-me-comments",
			"database_id": "b822fdaf-a1bb-4213-8e74-ffd1d5dc5b9f"
		}
	],
	"routes": [{ "pattern": "api.dibakar.me", "custom_domain": true }]
}