// Cloudflare Worker config: serves the static export in ./out and the
// comments API from the same Worker (same-origin, no CORS).
//
// After `wrangler d1 create dibakar-me-comments`, paste the returned
// database_id below. The Turnstile secret is not stored here — set it once
// with `wrangler secret put TURNSTILE_SECRET_KEY`.
{
	"name": "dibakar-me",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./out",
		"not_found_handling": "404-page",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dibakar-me-comments",
			"database_id": "b822fdaf-a1bb-4213-8e74-ffd1d5dc5b9f",
			"remote": true
		}
	]
}